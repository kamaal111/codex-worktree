{
  "name": "codex-worktree",
  "version": "0.1.0",
  "description": "Run Codex CLI sessions in isolated Git worktrees.",
  "keywords": [
    "codex",
    "git",
    "worktree",
    "cli"
  ],
  "license": "MIT",
  "author": "Kamaal Farah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamaal111/codex-worktree.git"
  },
  "bin": {
    "codex-worktree": "bin/run.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && vitest --run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "quality": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "prepack": "pnpm run build",
    "release": "node ./scripts/publish.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.81.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
